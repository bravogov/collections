#!/usr/bin/env bash
set -euo pipefail

# Git-sourced component dependencies do not include the node_modules assets
# that the published upstream RubyGem packages after its Yarn installation.
component_dir="$(bundle show govuk_publishing_components)"
expected_sha='e107a9c6e01d4bd9facf97af22ec60ca3e40fe3d'
actual_sha="$(git -C "$component_dir" rev-parse HEAD)"
if [[ "$actual_sha" != "$expected_sha" ]]; then
  echo "Refusing to package unexpected publishing components: $actual_sha" >&2
  exit 1
fi

# Invoke Yarn Classic directly: an application-level Yarn 3 configuration must
# not replace the version that owns the component's existing v1 lockfile.
yarn_tool_dir="$(mktemp -d)"
trap 'rm -rf "$yarn_tool_dir"' EXIT
npm pack --silent --ignore-scripts --pack-destination "$yarn_tool_dir" yarn@1.22.22 > /dev/null
tar -xzf "$yarn_tool_dir/yarn-1.22.22.tgz" -C "$yarn_tool_dir"

# The Bundler Git checkout sits below the application's Yarn 3 project.
# Install from the component's own exact package manifest and lockfile outside
# that directory, as the original released RubyGem build does.
frontend_dir="$yarn_tool_dir/frontend"
mkdir -p "$frontend_dir"
cp "$component_dir/package.json" "$component_dir/yarn.lock" "$component_dir/.yarnrc" "$frontend_dir/"
(
  cd "$frontend_dir"
  test "$(YARN_IGNORE_PATH=1 node "$yarn_tool_dir/package/bin/yarn.js" --version)" = "1.22.22"
  YARN_IGNORE_PATH=1 node "$yarn_tool_dir/package/bin/yarn.js" install --frozen-lockfile --production=true --ignore-scripts --non-interactive
  node -e 'const fs=require("node:fs"); const p="node_modules/govuk-frontend/package.json"; if (!fs.existsSync(p) || JSON.parse(fs.readFileSync(p)).version !== "6.1.0") process.exit(1);'
  test -f node_modules/govuk-frontend/dist/govuk/_base.scss
)
mkdir -p "$component_dir/node_modules"
cp -a "$frontend_dir/node_modules/." "$component_dir/node_modules/"
test -f "$component_dir/node_modules/govuk-frontend/dist/govuk/_base.scss"
echo 'Verified pinned component frontend assets are installed.'
