<%# Whitehall promotional features supersede individual fallback cards, while contact and updates remain independent. %>
<% promoted_titles = Array(@documents.promotional_image_features).map { |feature| feature[:title].to_s.downcase } %>
<% show_leadership = promoted_titles.none? { |title| title.include?("chief minister") } %>
<% show_history = promoted_titles.none? { |title| title == "history" } %>
<% if show_leadership || show_history %>
<section class="organisation__margin-bottom organisation__section-wrap" aria-label="Chief Minister's Office">
  <div class="govuk-grid-row">
    <% if show_leadership %>
    <div class="govuk-grid-column-one-half">
      <div class="organisation__promotion">
        <%= render "govuk_publishing_components/components/heading", {
          text: "Meet the Chief Minister",
          heading_level: 2,
          padding: true,
          margin_bottom: 3,
          border_top: 5,
          brand: @organisation.brand
        } %>
        <p class="govuk-body"><%= t("organisations.no10_overview.leadership_summary") %></p>
        <p class="govuk-body"><%= link_to "Meet the Chief Minister", "/government/ministers/chief-minister", class: "govuk-link" %></p>
      </div>
    </div>
    <% end %>
    <% if show_history %>
    <div class="govuk-grid-column-one-half">
      <div class="organisation__promotion">
        <%= render "govuk_publishing_components/components/heading", {
          text: "History",
          heading_level: 2,
          padding: true,
          margin_bottom: 3,
          border_top: 5,
          brand: @organisation.brand
        } %>
        <p class="govuk-body"><%= t("organisations.no10_overview.history_summary") %></p>
        <p class="govuk-body"><%= link_to "Read about the Cabinet Office", "/government/organisations/cabinet-office", class: "govuk-link" %></p>
      </div>
    </div>
    <% end %>
  </div>
</section>
<% end %>
  <section class="organisation__margin-bottom organisation__section-wrap" aria-label="Correspondence and updates">
    <div class="govuk-grid-row">
      <% if @organisation.ordered_contacts.blank? %>
      <div class="govuk-grid-column-two-thirds">
        <%= render "govuk_publishing_components/components/heading", {
          text: "Contact No. 10 Harrington Court",
          heading_level: 2,
          padding: true,
          margin_bottom: 3,
          border_top: 5,
          brand: @organisation.brand
        } %>
        <h3 class="govuk-heading-s"><%= t("organisations.no10_overview.correspondence_heading") %></h3>
        <p class="govuk-body"><%= t("organisations.no10_overview.correspondence_summary") %></p>
        <p class="govuk-body"><%= link_to "Write to Cabinet Office ministers", "https://submit.forms.service.gov.uhrblx.com/form/17", class: "govuk-link" %></p>
      </div>
      <% end %>
      <div class="govuk-grid-column-one-third">
        <%= render "govuk_publishing_components/components/heading", {
          text: "Official updates",
          heading_level: 2,
          padding: true,
          margin_bottom: 3,
          border_top: 5,
          brand: @organisation.brand
        } %>
        <p class="govuk-body"><%= link_to "Latest news from the Chief Minister's Office", "#latest-news", class: "govuk-link" %></p>
      </div>
    </div>
  </section>
